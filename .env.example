# Copy to .env (`make setup` does this) and fill in. .env is gitignored.

# --- Go2 Air ("Roxy"), WebRTC STA-L ---
# Robot's IP on the shared Wi-Fi (STA-L mode)
GO2_IP=
# Per-device AES-128 key (32 hex chars), required on firmware >= 1.1.15
GO2_AES_KEY=
GO2_CONN_TYPE=webrtc

# --- ROS 2 ---
ROS_DOMAIN_ID=0
# Required: interface DDS uses on this machine, the one on the robot/Pi LAN.
# Find it with `ip route get 1.1.1.1` (the word after "dev"), e.g. wlp7s0.
DDS_IFACE=

# --- Machines ---
# The Pi's LAN IP: also the unicast DDS peer (configs/cyclonedds.xml)
PI_IP=
# LAN IP of the machine running bringup (workstation or laptop): the Pi's DDS peer.
# Needed in the Pi's .env; leave empty on the bringup machine.
BRIDGE_IP=
WORKSTATION_TS_IP=

# --- Mic speech-to-text (audio_stt) ---
# false on a machine without the DJI Mic Mini receiver plugged in
STT=true

# --- NaVILA server ---
NAVILA_PRECISION=4bit
NAVILA_PORT=8000
# URL the ROS side uses to reach the server (Tailscale IP for remote demos)
NAVILA_SERVER_URL=http://127.0.0.1:8000
# RGB topic NaVILA sees: camera/image_raw (Go2 front camera) or orbbec/color/image_decoded
# (the Pi's Orbbec, decoded by bringup; needs `make pi-up` on the Pi)
NAVILA_CAMERA_TOPIC=camera/image_raw

# --- Local paths (relative to the repo root) ---
# Fork copies, until they move to ros_ws/src/go2_ros2_sdk and third_party/NaVILA
GO2_SDK_DIR=./go2_sdk/src
NAVILA_DIR=./NaVila/NaVILA
# Weights are mounted read-only into the NaVILA container, never baked into the image
NAVILA_CHECKPOINTS_DIR=./NaVila/NaVILA/checkpoints
NAVILA_MODEL=navila-llama3-8b-8f
