# Copy to .env (`make setup` does this) and fill in. .env is gitignored.

# --- Go2 Air ("Roxy"), WebRTC STA-L ---
# Robot's IP on the shared Wi-Fi (STA-L mode)
GO2_IP=
# Per-device AES-128 key (32 hex chars), required on firmware >= 1.1.15
GO2_AES_KEY=
GO2_CONN_TYPE=webrtc

# --- ROS 2 ---
ROS_DOMAIN_ID=0
# Required: interface DDS uses on this machine, the one on the robot/Pi LAN.
# Find it with `ip route get 1.1.1.1` (the word after "dev"), e.g. wlp7s0.
DDS_IFACE=

# --- Machines ---
# The Pi's LAN IP: also the unicast DDS peer (configs/cyclonedds.xml)
PI_IP=
# LAN IP of the machine running bringup (workstation or laptop). Set it on BOTH machines:
# the Pi's DDS peer, and on the bringup machine its own address, so its processes still find
# each other where a firewall blocks localhost (k3s on the workstation does).
BRIDGE_IP=
# The workstation's Tailscale IP (tailscale ip -4), for reference; NAVILA_SERVER_URL is what is used
WORKSTATION_TS_IP=

# --- Mic speech-to-text (audio_stt) ---
# false on a machine without a mic
STT=true
# dji: the DJI Mic Mini receiver (USB); builtin: this machine's own mic (configs/robots/roxy.yaml)
MIC=dji

# --- Spoken replies (voice) ---
# true: Gemini decides command vs question and Roxy answers through the Pi speaker
VOICE=false
# Gemini API key (https://aistudio.google.com/apikey), for VOICE=true
GEMINI_API_KEY=
# false without the Pi speaker: Roxy's replies are only logged and the mic is never muted
SPEAKER=true
# --- Hand-gesture driving (go2_gesture) ---
# true: hand signs in front of the Go2 camera drive it (cmd_vel, below the joystick)
GESTURE=false

# --- NaVILA server ---
NAVILA_PRECISION=4bit
NAVILA_PORT=8000
# URL the ROS side uses to reach the server. Live demo (make demo-site on the laptop):
# http://<workstation Tailscale IP>:8000, which make demo-gpu prints
NAVILA_SERVER_URL=http://127.0.0.1:8000
# What NaVILA and the dashboard see (Makefile): go2 = the Go2's front camera, no Pi needed;
# orbbec = the Pi's Orbbec, decoded by bringup (needs `make pi-up` on the Pi). Also on the
# command line for one run: make demo-site CAMERA=orbbec
CAMERA=go2
# RGB topic NaVILA sees, used only when CAMERA is unset
NAVILA_CAMERA_TOPIC=camera/image_raw

# --- Local paths (relative to the repo root) ---
# Fork copies, until they move to ros_ws/src/go2_ros2_sdk and third_party/NaVILA
GO2_SDK_DIR=./go2_sdk/src
NAVILA_DIR=./NaVila/NaVILA
# Weights are mounted read-only into the NaVILA container, never baked into the image
NAVILA_CHECKPOINTS_DIR=./NaVila/NaVILA/checkpoints
NAVILA_MODEL=navila-llama3-8b-8f

# --- Pi camera (robot/pi/README.md) ---
# true: the Orbbec also streams depth. Needs a 5 V / 5 A supply on the Pi, or the camera drops off USB
PI_DEPTH=false
