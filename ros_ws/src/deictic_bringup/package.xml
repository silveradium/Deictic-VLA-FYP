<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>deictic_bringup</name>
  <version>0.1.0</version>
  <description>Robot-side bringup for Deictic-VLA: mode:=collect|infer.</description>
  <maintainer email="rivikulafernando2@gmail.com">Deictic-VLA FYP team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>go2_robot_sdk</exec_depend>
  <exec_depend>navila_node</exec_depend>
  <exec_depend>audio_stt</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
