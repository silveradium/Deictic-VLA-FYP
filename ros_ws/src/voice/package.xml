<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice</name>
  <version>0.1.0</version>
  <description>Roxy's spoken replies: Gemini dialog (navigate, trick or answer) + Piper TTS with dog voice effects.</description>
  <maintainer email="rivikulafernando2@gmail.com">Deictic-VLA FYP team</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tricks</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
